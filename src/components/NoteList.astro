---
import { withBase } from '../lib/urls';
import type { CollectionEntry } from 'astro:content';
import { formatDate, kindLabels } from '../lib/publication';
import Icon from './Icon.astro';
interface Props { notes: CollectionEntry<'notes'>[]; }
const { notes } = Astro.props;
---
{notes.length > 0 ? (
  <ol class="note-list">
    {notes.map(({ id, data }) => (
      <li>
        <article class="note-row note-card">
          <div class="note-card-top">
            <div class="note-date">
              <time datetime={data.published}>{formatDate(data.published!)}</time>
              <span class="meta-dot" aria-hidden="true"></span>
              <span class="note-kind">{kindLabels[data.kind]}</span>
            </div>
            <div class="note-summary">
              <h3><a href={withBase(`/writing/${id}/`)}>{data.title}</a></h3>
              <p>{data.summary}</p>
            </div>
          </div>
          <div class="note-card-bottom">
            <ul class="topic-labels" aria-label="Topics">{data.topics.map(topic => <li>{topic}</li>)}</ul>
            <a class="note-arrow" href={withBase(`/writing/${id}/`)} aria-hidden="true" tabindex="-1">
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>
      </li>
    ))}
  </ol>
) : (
  <div class="notes-empty"><p>No notes published yet.</p><p>For now, start with <a href={withBase('/projects/personal-memory/')}>the thinking behind personal-memory <span aria-hidden="true">↗</span></a>—the problem, the approach, and the tradeoffs.</p></div>
)}
