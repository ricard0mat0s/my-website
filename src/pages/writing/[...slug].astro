---
import { withBase } from '../../lib/urls';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedNotes, formatDate, kindLabels } from '../../lib/publication';
import { site } from '../../config';

export async function getStaticPaths() {
  return publishedNotes(await getCollection('notes')).map(note => ({ params: { slug: note.id }, props: { note } }));
}
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const { data } = note;
const { Content, headings } = await render(note);
const sections = headings.filter(heading => heading.depth === 2);
---
<SiteLayout title={`${data.title} — Ricardo`} description={data.summary} section="writing" article>
  <Fragment slot="head"><meta property="article:published_time" content={`${data.published}T00:00:00Z`} />{data.updated && <meta property="article:modified_time" content={`${data.updated}T00:00:00Z`} />}</Fragment>
  <article class="note-page">
    <header class="reading-header">
      <a href={withBase('/writing/')} class="text-link breadcrumb">← All writing</a>
      <p class="eyebrow">{kindLabels[data.kind]}</p>
      <h1>{data.title}</h1>
      <p class="reading-deck">{data.summary}</p>
      <div class="article-meta"><span>By {site.name}</span><time datetime={data.published}>{formatDate(data.published!)}</time>{data.updated && <span>Updated <time datetime={data.updated}>{formatDate(data.updated)}</time></span>}</div>
      <ul class="topic-labels" aria-label="Topics">{data.topics.map(topic => <li>{topic}</li>)}</ul>
    </header>
    <div class:list={['reading-grid', { 'short-note': sections.length === 0 }]}>
      {sections.length > 0 && <aside class="reading-sidebar"><nav aria-label="On this page"><p class="eyebrow">In this {data.kind === 'experiment' ? 'log' : data.kind}</p><ol>{sections.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}
      <div class="article-body"><Content /><div class="reading-end">{data.relatedProject && <p>Related project: <a href={withBase('/projects/personal-memory/')}>personal-memory</a></p>}<a class="text-link" href={`mailto:${site.email}`}>Share a thought →</a></div></div>
    </div>
  </article>
</SiteLayout>
