---
import { withBase } from '../../lib/urls';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config';
export async function getStaticPaths() {
  return (await getCollection('projects', ({ data }) => !data.draft))
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const project = entry.data;
const { Content, headings: allHeadings } = await render(entry);
const headings = allHeadings.filter(heading => heading.depth === 2);
---
<SiteLayout title={`${project.title} — Ricardo`} description={project.description} section="projects">
  <article class="project-page">
    <header class="reading-header">
      <a href={withBase('/#projects')} class="text-link breadcrumb">← Projects</a>
      <p class="eyebrow">Project / {project.status}</p>
      <h1>{project.title}</h1>
      <p class="reading-deck">{project.subtitle}</p>
      <p class="project-description">{project.description}</p>
      <div class="project-facts"><span>{project.stack}</span>{project.repository && <a class="text-link" href={project.repository}>View the code <Icon name="arrow" size={16} /></a>}</div>
    </header>
    <div class:list={['reading-grid', { 'short-note': headings.length === 0 }]}>
      {headings.length > 0 && <aside class="reading-sidebar"><nav aria-label="On this page"><p class="eyebrow">In this project</p><ol>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}
      <div class="article-body"><Content /><div class="reading-end"><p>Working through a similar idea?</p><a class="text-link" href={`mailto:${site.email}`}>Let’s talk about it <Icon name="arrow" size={16} /></a></div></div>
    </div>
  </article>
</SiteLayout>
