---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import { Content as Introduction, frontmatter as intro } from '../content/home/intro.md';
import { frontmatter as story } from '../content/home/project.md';
import { Content as Contact, frontmatter as contact } from '../content/home/contact.md';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import NoteList from '../components/NoteList.astro';
import { publishedNotes } from '../lib/publication';
import { site } from '../config';

const notes = publishedNotes(await getCollection('notes'));
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const featured = projects.find(project => project.id === story.project);
if (!featured) throw new Error(`The homepage featured project "${story.project}" must exist and have draft: false.`);
---
<SiteLayout>
  <section class="intro" aria-labelledby="intro-heading">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="intro-inner">
      <div class="hero-pill">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>{intro.eyebrow} Undergraduate Researcher &amp; Engineer</span>
      </div>
      <h1 id="intro-heading">{intro.title} <span class="hero-gradient">{intro.accent}</span></h1>
      <p class="intro-aside">{intro.aside}</p>
      <div class="intro-copy"><Introduction /></div>
      <div class="intro-actions">
        <a class="btn-primary" href="#projects"><span>Explore Projects</span> <Icon name="down" size={16} /></a>
        {notes.length > 0 && <a class="btn-secondary" href="#writing"><span>Read Notes</span></a>}
        <a class="btn-ghost" href="#contact"><span>Contact</span> <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span>Deep Dive · Case Study</span>
    <span>01 / 03</span>
  </div>

  <section id="projects" class="projects-section section" aria-labelledby="projects-heading">
    <span id="building" class="anchor-alias" aria-hidden="true"></span>
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Curated Work</p>
        <h2 id="projects-heading">Selected Projects</h2>
      </div>
    </div>
    <ul class="project-grid">
      {projects.map((project, index) => {
        const number = String(index + 1).padStart(2, '0');
        const category = project.id === 'personal-memory' ? 'MCP & PERSISTENCE' : project.data.subtitle;
        const tags = project.data.stack.split('·').map(tag => tag.trim()).filter(Boolean);
        return (
          <li class="project-card">
            <div class="project-card-top">
              <div class="project-card-meta">
                <span class="project-index">{number} / {category}</span>
                <span class="status-badge">
                  <span class="status-dot" aria-hidden="true"></span>
                  {project.data.status}
                </span>
              </div>
              <h3><a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a></h3>
              <p class="project-card-desc">{project.data.description}</p>
            </div>
            <div class="project-card-bottom">
              <ul class="tech-tags" aria-label="Technologies">
                {tags.map(tag => <li>{tag}</li>)}
              </ul>
              <a class="card-action" href={withBase(`/projects/${project.id}/`)}>
                <span>View details</span>
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  {notes.length > 0 && (
    <>
      <div class="section-divider" aria-hidden="true">
        <span>Writing · Insights</span>
        <span>02 / 03</span>
      </div>
      <section id="writing" class="writing section" aria-labelledby="writing-heading">
        <span id="latest-notes" class="anchor-alias" aria-hidden="true"></span>
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">Writing &amp; Perspectives</p>
            <h2 id="writing-heading">Latest notes</h2>
          </div>
          <a class="section-link" href={withBase('/writing/')}>
            <span>All writing</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>
        <NoteList notes={notes.slice(0, 4)} />
      </section>
    </>
  )}

  <div class="section-divider" aria-hidden="true">
    <span>Dialogue · Contact</span>
    <span>03 / 03</span>
  </div>

  <section id="contact" class="connect section" aria-labelledby="contact-heading">
    <span id="connect" class="anchor-alias" aria-hidden="true"></span>
    <div class="contact-card">
      <div class="contact-content">
        <p class="section-eyebrow">Dialogue</p>
        <h2 id="contact-heading">{contact.title}</h2>
        <div class="contact-copy"><Contact /></div>
      </div>
      <div class="contact-links">
        <a class="btn-primary email-button" href={`mailto:${site.email}`}>
          <span>{contact.linkLabel}</span>
          <Icon name="mail" size={16} />
        </a>
        <a class="btn-secondary" href={site.github}>
          <span>GitHub</span>
          <Icon name="arrow" size={15} />
        </a>
        <a class="btn-secondary" href={site.linkedin}>
          <span>LinkedIn</span>
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
