---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import { publishedNotes } from '../lib/publication';
import { site } from '../config';
import Icon from '../components/Icon.astro';
import '@fontsource-variable/dm-sans';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; section?: 'projects' | 'writing'; article?: boolean; }
const { title = site.title, description = site.description, section, article = false } = Astro.props;
const hasNotes = publishedNotes(await getCollection('notes')).length > 0;
const home = Astro.url.pathname === withBase('/');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131313" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner container">
        <div class="header-brand">
          <a class="wordmark" href={home ? '#top' : withBase('/')} aria-label="Ricardo — home">ricardo<span>.</span></a>
          <div class="collab-badge">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>Available for collaborations</span>
          </div>
        </div>
        <nav class="glass-nav" aria-label="Main navigation">
          <a href={home ? '#projects' : withBase('/#projects')} aria-current={section === 'projects' || (!section && home) ? 'true' : undefined}>Projects</a>
          {hasNotes && <a href={home ? '#writing' : withBase('/writing/')} aria-current={section === 'writing' ? 'true' : undefined}>Writing</a>}
          <a href={home ? '#contact' : withBase('/#contact')}>Contact</a>
        </nav>
        <div class="header-actions" aria-hidden="true">
          <div class="header-avatar">
            <Icon name="person" size={18} />
          </div>
        </div>
      </div>
    </header>
    <main id="main" class="site-main container" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="colophon container">
        <div class="colophon-info">
          <a href={withBase('/')} class="footer-name">{site.name}<span>.</span></a>
          <span aria-hidden="true">—</span>
          <p>Building, studying, sharing.</p>
        </div>
        <a href="#top" class="back-top"><span>Back to top</span> <Icon name="up" size={14} /></a>
      </div>
      <div class="footer-surface">
        <div class="footer-inner container">
          <div class="footer-meta">
            <div class="footer-brand">
              <span class="footer-mark">r<span>.</span></span>
              <span class="footer-author">Ricardo Matos</span>
            </div>
            <p class="footer-copy">© 2026 Ricardo Matos. Engineered with precision.</p>
          </div>
          <div class="footer-links">
            <a href={site.github}>GitHub</a>
            <a href={site.linkedin}>LinkedIn</a>
            <a href={`mailto:${site.email}`}>Email</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
